[Unit]
Description=ARIA: redirect http://:80 to https://:443
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=mohanax25
Group=users
WorkingDirectory=/homes/mohanax25/ARIA_dev
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ExecStart=/homes/mohanax25/node22/bin/node deploy/scripts/redirect-to-https.mjs
Restart=always
RestartSec=5
StandardOutput=append:/homes/mohanax25/ARIA_dev/logs/redirect.log
StandardError=append:/homes/mohanax25/ARIA_dev/logs/redirect.log
[Install]
WantedBy=multi-user.target
