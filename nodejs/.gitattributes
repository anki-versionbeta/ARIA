# Shell scripts must keep LF endings. A CRLF in the shebang of
# docker-entrypoint.sh makes Linux fail with "no such file or directory" for a
# file that is plainly there. The nginx template is read by envsubst and nginx,
# both of which want LF too.
*.sh text eol=lf
Dockerfile text eol=lf
nginx.conf.template text eol=lf
.dockerignore text eol=lf
