# The one place credentials are configured. Copy to .env for local development.
#
# Silos never read these. They receive `ctx.llm` and `ctx.storage`, and a contract
# test (tests/test_silo_isolation.py) fails the build if a silo reaches for a key,
# a bucket or boto3 itself.
#
# Values marked * must come from the secret store in every deployed environment and
# must never be committed.

# ── Runtime ───────────────────────────────────────────────────────────────────
DA_ENV=local
LOG_LEVEL=INFO
# LDAP is the default provider; any AbbVie account can sign in. AUTH_PROVIDER=dev
# is for automated tests only and refuses to start outside DA_ENV=local.
# AUTH_PROVIDER=ldap

# ── Data and storage ──────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./dev.db
# STORAGE_DIR=./dev_storage
# MAX_UPLOAD_MB=200

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET=*                      required outside DA_ENV=local
JWT_TTL_HOURS=8
LDAP_URL=ldaps://ldap-ad.abbvienet.com:636
LDAP_DOMAIN=abbvienet.com
# No LDAP_BIND_DN or LDAP_BASE_DN: authentication is a direct simple bind on the
# UPN (user@abbvienet.com), so no service account is needed.

# ── TLS ───────────────────────────────────────────────────────────────────────
# Combined bundle: public roots (for hosts the proxy does not intercept, such as
# S3) plus the AbbVie chain (for abbvienet.com and Artifactory).
# Regenerate with: python scripts/build_ca_bundle.py
CA_BUNDLE_PATH=./certs/ca-bundle.pem

# ── Iliad (shared by every silo) ──────────────────────────────────────────────
ILIAD_BASE_URL=https://iliad-emerging-api.abbvienet.com
# ILIAD_API_KEY=*
# ILIAD_USER_TOKEN=*                Active Directory token; ISO's RAG calls need it
#
# Defaults only. ISO passes gpt-5.2 and BOP claude-4.5-sonnet per call, because the
# two silos deliberately use different models.
LLM_TEXT_MODEL=claude-4.5-sonnet
LLM_VISION_MODEL=gpt-5.2-global
#
# Per PROCESS, not cluster-wide. Workers are separate processes, so the real ceiling
# is this value times the worker count. Set it to the global budget divided by the
# number of workers. Iliad's documented caps are still an open item.
LLM_MAX_CONCURRENCY=8
TEXTRACT_MAX_CONCURRENCY=4

# ── AWS (shared by every silo) ────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=ir-doc-authoring
S3_PREFIX=ISO_Doc_Generation
# Prefer an instance or workload identity so there are no static keys at all. These
# are only for local development against temporary STS credentials, in which case
# AWS_SESSION_TOKEN is mandatory (keys beginning "ASIA").
# AWS_ACCESS_KEY_ID=*
# AWS_SECRET_ACCESS_KEY=*
# AWS_SESSION_TOKEN=*

# ── Silos ─────────────────────────────────────────────────────────────────────
# Comma-separated allow-list, used to ship a silo dark. Empty means all registered.
# ENABLED_SILOS=bop,iso
